# Safe local defaults. Copy to .env to override; do not commit that file.
# Speed, sales history depth and seller storage are normally changed in Settings in the UI.
APP_SOURCE_MODE=live
APP_ENVIRONMENT=development
APP_BACKEND_BIND_HOST=127.0.0.1
APP_FRONTEND_BIND_HOST=127.0.0.1
# Required in production when data/release.json and Git metadata are unavailable.
APP_REVISION=
# APP_DATABASE_URL defaults to the absolute repository data/grailed.db path.
APP_SQLITE_BUSY_TIMEOUT_MS=5000
APP_LOG_LEVEL=INFO
# Compliance ceilings: at most 90 requests per minute and 3 concurrent requests.
APP_REQUESTS_PER_MINUTE=90
APP_MAX_CONCURRENT_REQUESTS=3
# Sold listings older than this are not collected; active listings are always collected.
APP_SOLD_HISTORY_DAYS=365
APP_DISCOVERY_TTL_HOURS=12
APP_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
APP_STORE_SELLER_IDENTITY=hashed
# Optional. If empty, one salt is generated once in ignored data/secrets/.
APP_SELLER_IDENTITY_SALT=
APP_RAW_DATA_RETENTION_DAYS=90
APP_BACKUP_RETENTION_DAYS=30
