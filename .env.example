# Safe local defaults. Copy to .env to override; do not commit that file.
APP_SOURCE_MODE=live
APP_ENVIRONMENT=development
APP_BACKEND_BIND_HOST=127.0.0.1
APP_FRONTEND_BIND_HOST=127.0.0.1
# Required in production when data/release.json and Git metadata are unavailable.
APP_REVISION=
# APP_DATABASE_URL defaults to the absolute repository data/grailed.db path.
APP_SQLITE_BUSY_TIMEOUT_MS=5000
APP_LOG_LEVEL=INFO
# Live discovery, parser runs and canary remain blocked until this is explicitly true.
APP_LIVE_COMPLIANCE_ACKNOWLEDGED=false
APP_REQUESTS_PER_MINUTE=90
APP_MAX_CONCURRENT_REQUESTS=3
APP_FETCH_TIER_PREFERRED=T1
APP_FETCH_TIER_ALLOW_BROWSER=true
APP_FETCH_TIER_ALLOW_DOM=true
APP_ALGOLIA_HITS_PER_PAGE=200
APP_ALGOLIA_MULTIQUERY_BATCH_SIZE=8
APP_ALGOLIA_PAGINATION_STRATEGY=auto
APP_ALGOLIA_ATTRIBUTES_MODE=full
APP_PARSER_REQUEST_TIMEOUT_S=15
APP_PARSER_MAX_RETRIES=3
APP_PARSER_MAX_CONCURRENCY=1
APP_PARSER_MAX_REQUESTS_PER_RUN=800
APP_PARSER_MAX_ITEMS_PER_BRAND=500
APP_PARSER_PROGRESS_INTERVAL_S=2
APP_BROWSER_MAX_PAGES=2
APP_BROWSER_RESTART_EVERY_REQUESTS=300
APP_DISCOVERY_TTL_HOURS=12
APP_DISCOVERY_SAMPLE_SIZE=200
APP_DISCOVERY_PAGE_TIMEOUT_S=45
APP_PROXY_ENABLED=false
APP_PROXY_ALLOW_DIRECT_FALLBACK=true
APP_CORS_ORIGINS=["http://127.0.0.1:3000"]
APP_PARSER_MODE=delta
APP_PARSER_FULL_REFRESH_DAYS=7
APP_PARSER_REFRESH_ACTIVE_ENABLED=true
APP_PARSER_REMOVED_CONFIRM_HOURS=48
APP_PARSER_WATERMARK_OVERLAP_HOURS=2
APP_QUALITY_PRICE_OUTLIER_MAD_K=6
APP_QUALITY_FILTER_REPLICAS=true
APP_QUALITY_LOT_PRICE_MULTIPLIER=1.5
APP_IDENTITY_IMAGE_REQUESTS_PER_RUN=100
APP_FX_PROVIDER=static
APP_STORE_SELLER_IDENTITY=hashed
# Optional. If empty, one salt is generated once in ignored data/secrets/.
APP_SELLER_IDENTITY_SALT=
APP_RAW_DATA_RETENTION_DAYS=90
APP_BACKUP_RETENTION_DAYS=30

# Leave empty unless real-source access is explicitly configured. Use JSON arrays
# (or a comma-separated list) and never commit the real .env file.
APP_PROXY_URL=
APP_PROXY_LIST_HTTP=[]
APP_PROXY_LIST_BROWSER=[]
